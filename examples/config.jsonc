// Sample config for waybar-rs development.
// Run with: cargo run -p waybar-rs -- -c examples/config.jsonc -s examples/style.css
{
    "position": "top",
    "layer": "top",
    "height": 28,
    "spacing": 4,
    // Do not reserve space, so a dev bar can run next to the real waybar.
    "exclusive": false,

    "modules-left": ["sway/workspaces", "sway/mode", "dummy"],
    "modules-center": ["clock", "sway/language", "keyboard-state"],
    "modules-right": [
        "custom/dev",
        "network",
        "idle_inhibitor",
        "power-profiles-daemon",
        "cpu",
        "memory",
        "battery",
        "backlight"
    ],

    "dummy": {
        "format": "waybar-rs"
    },

    "sway/workspaces": {
        "format": "{name}",
        "disable-scroll": true
    },

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },

    "sway/language": {
        "format": "{short:2}",
        "tooltip-format": "{long}"
    },

    "keyboard-state": {
        "capslock": true,
        "numlock": true,
        "format": {
            "capslock": "C",
            "numlock": "N"
        }
    },

    "custom/dev": {
        "exec": "date +%H:%M:%S",
        "interval": 1
    },

    "clock": {
        "format": "{:%H:%M:%S}",
        "format-alt": "{:%Y-%m-%d %A}",
        "tooltip": false,
        "calendar": {
            "week-start": "monday",
            "week-numbers": false,
            "show-weekdays": true,
            "other-months": true
        }
        // "locale": "ru_RU",
        // "timezone": "Europe/Moscow"
    },

    "cpu": {
        "format": "{usage:03}",
        "interval": 2,
        "tooltip": true
    },

    "memory": {
        "format": "{percentage:03}:{swapPercentage:03}",
        "interval": 2,
        "tooltip-format": "{total:0.1f}GiB total\n{used:0.1f}GiB used\n{avail:0.1f}GiB available"
    },

    "battery": {
        "format": "{capacity:03} {icon}",
        "format-charging": "{capacity:03} CHG",
        "format-not-charging": "{capacity:03} AC",
        "format-icons": ["", "", "", "", "", "", "", "", "", "", ""],
        "interval": 2,
        "states": { "critical": 15, "warning": 30, "good": 100 },
        "tooltip-format": "{timeTo}\n{cycles} cycles\nhealth {health:3}"
    },

    "backlight": {
        "format": "{percent:03}",
        "scroll-step": 0.5,
        "reverse-scrolling": true,
        "interval": 2,
        "tooltip": true
    },

    "network": {
        "format-disconnected": "NET off",
        "format-ethernet": "{ipaddr}/{cidr}",
        "format-icons": ["", "", "", ""],
        "format-linked": "{ifname} link",
        "format-wifi": "{essid} {icon}",
        "interval": 5,
        "tooltip": false
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "ON",
            "deactivated": "off"
        }
    },

    "power-profiles-daemon": {
        "format": "{icon} {profile}",
        "format-icons": {
            "default": "P",
            "performance": "P",
            "balanced": "B",
            "power-saver": "S"
        },
        "tooltip": true
    }
}
